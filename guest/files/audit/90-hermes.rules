## Hermes VM audit rules (aarch64). Keys let you search with: ausearch -k <key>
-D
-b 8192
-f 1

## Identity and privilege
-w /etc/passwd -p wa -k identity
-w /etc/group -p wa -k identity
-w /etc/shadow -p wa -k identity
-w /etc/gshadow -p wa -k identity
-w /etc/subuid -p wa -k identity
-w /etc/subgid -p wa -k identity
-w /etc/sudoers -p wa -k privilege
-w /etc/sudoers.d/ -p wa -k privilege

## Access and security controls
-w /etc/ssh/sshd_config -p wa -k sshd
-w /etc/ssh/sshd_config.d/ -p wa -k sshd
-w /etc/nftables.conf -p wa -k firewall
-w /usr/sbin/nft -p x -k firewall
-w /etc/apparmor.d/ -p wa -k apparmor
-w /etc/sysctl.d/ -p wa -k sysctl
-w /etc/modprobe.d/ -p wa -k modules

## Hermes / container runtime
-w /home/hermes/.config/docker/ -p wa -k docker
-w /home/hermes/hermes/ -p wa -k hermes-config
-w /usr/bin/docker -p x -k docker

## Behaviour
-a always,exit -F arch=b64 -S execve -F euid=0 -F auid>=1000 -F auid!=unset -k root-exec
-a always,exit -F arch=b64 -S init_module,finit_module,delete_module -k modules
-a always,exit -F arch=b64 -S mount,umount2 -F auid>=1000 -F auid!=unset -k mounts
-a always,exit -F arch=b64 -S ptrace -k ptrace

## Uncomment to make rules immutable until reboot (do this once you're happy with the build)
# -e 2
