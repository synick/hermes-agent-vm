// All values are generated by hermes-vm.sh into ~/.config/hermes-vm/build/hermes.pkrvars.hcl.
// Secrets (admin_password, admin_password_hash) arrive as PKR_VAR_* environment variables, read from the Keychain.

variable "vm_name" { type = string }

variable "role" { // "hermes" (the agent VM) or "router" (its only way out)
  type    = string
  default = "hermes"
  validation {
    condition     = contains(["hermes", "router"], var.role)
    error_message = "The role must be hermes or router."
  }
}
variable "output_directory" { type = string }
variable "iso_url" { type = string }
variable "iso_checksum" { type = string }
variable "fusion_network" { type = string }
variable "vm_gw" { type = string }
variable "llm_port" { type = number }
variable "llm_model" { type = string }
variable "hermes_image_tag" { type = string }
variable "cpus" { type = number }
variable "memory_mb" { type = number }
variable "disk_size_mb" { type = number }
variable "headless" { type = bool }
variable "timezone" { type = string }
variable "dns_servers" { type = list(string) }
variable "admin_username" { type = string }
variable "report_dir" { type = string } // where build reports land on the Mac
variable "ssh_public_key_file" { type = string }        // your real key, installed at the end
variable "build_ssh_private_key_file" { type = string } // throwaway key for this build only
variable "build_ssh_public_key_file" { type = string }

variable "boot_wait" {
  type    = string
  default = "6s"
}

variable "admin_password" {
  type      = string
  sensitive = true
}

variable "admin_password_hash" {
  type      = string
  sensitive = true
}

// Separate VNC port ranges (used only to type the boot command) so two VMs can build at the same time.
variable "vnc_port_min" {
  type    = number
  default = 5900
}
variable "vnc_port_max" {
  type    = number
  default = 5949
}
