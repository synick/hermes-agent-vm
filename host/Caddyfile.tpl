# hermes-vm Ollama gateway - generated by hermes-vm.sh from host/Caddyfile.tpl.
# Listens only on the Mac's address on the router uplink (Hermes reaches it through the router's port forward);
# passes inference/read-only paths to Ollama on loopback.
{
	admin off
	auto_https off
}

# Any Host header: Hermes asks for the router's address ({{VM_GW}}), which the router forwards here. Where Caddy
# listens is restricted by "bind" (the uplink address only), not by the site address.
http://:{{LLM_PORT}} {
	bind {{UPLINK_GW}}

	request_body {
		max_size 20MB
	}

	@allowed {
		method GET POST
		path /v1/chat/completions /v1/embeddings /v1/models /v1/models/* /api/tags /api/show /api/version
	}

	handle @allowed {
		reverse_proxy 127.0.0.1:11434 {
			header_up Host 127.0.0.1:11434
		}
	}

	# Model management (/api/pull, /api/push, /api/create, /api/delete, /api/copy, /api/blobs/*) and anything new: refused.
	handle {
		respond "forbidden" 403
	}

	log {
		output file "{{LOG_DIR}}/hermes-vm-gateway.log"
		format json
	}
}
