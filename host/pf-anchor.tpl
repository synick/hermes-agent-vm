# hermes-vm pf anchor - generated by hermes-vm.sh from host/pf-anchor.tpl. Loaded as com.apple/hermes-vm,
# alongside (never replacing) the rules VMware Fusion and macOS put in pf.
#
# Applies to the router VM's uplink network. Hermes itself is never on a network the Mac is on: its traffic reaches
# here only after the router VM's firewall has passed it. This is the Mac's own second layer.
# Policy for traffic arriving FROM the uplink:  internet = allowed;  the Mac = only the Ollama gateway port;
# every local / private / special-purpose network, wherever the Mac happens to be = blocked. (Fusion's NAT runs in
# a userspace helper, so rules 5 and 6 can't see NATed traffic; the router VM enforces those for Hermes.)

# vm_if (the VM's bridge interface) is supplied at load time by pf-load.sh with -D vm_if=<iface>.
# While the VM isn't running, the two lines that use it are left out entirely.
vm_net   = "{{UPLINK_SUBNET}}/24"
vm_gw    = "{{UPLINK_GW}}"
llm_port = "{{LLM_PORT}}"

table <nonpublic4> const { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, \
    169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.168.0.0/16, \
    198.18.0.0/15, 224.0.0.0/4, 240.0.0.0/4 }

# 0. Mac -> router SSH (admin, and the hop into Hermes). Keeps state so the VM's replies are allowed back.
pass out quick proto tcp from $vm_gw to $vm_net port 22 keep state

# 1. DHCP within the VM network only (before anti-spoof: a DHCP request comes from 0.0.0.0).
pass in quick proto udp from any port 68 to { 255.255.255.255, $vm_net } port 67

# 2. On the VM's interface: drop spoofed sources and all IPv6.
block drop in log quick on $vm_if from ! $vm_net
block drop in log quick on $vm_if inet6

# 3. The one service on the Mac the VM may use: the Ollama gateway (Caddy).
pass in quick proto tcp from $vm_net to $vm_gw port $llm_port keep state

# 4. Nothing else on the Mac.
block drop in log quick from $vm_net to $vm_gw

# 5. Whatever network the Mac is on right now, whatever its address range (re-evaluated as you roam).
block drop in log quick from $vm_net to { (en0:network) }

# 6. All private and special-purpose IPv4 ranges (LANs, hotspots, CGNAT/Tailscale, link-local, multicast).
block drop in log quick from $vm_net to <nonpublic4>

# 7. The internet.
pass in quick inet from $vm_net to any keep state
